{
  "name": "@levity/persistence",
  "version": "1.0.0",
  "private": true,
  "description": "TypeORM entities, repositories, DataSource and migrations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typeorm": "typeorm-ts-node-commonjs -d ./src/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@levity/config": "1.0.0",
    "@levity/domain": "1.0.0",
    "@levity/observability": "1.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
