{
  "name": "levity-api",
  "version": "1.0.0",
  "description": "Levity backend API",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "rebuild": "tsc -b --clean && tsc -b",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "start:api": "npm run start -w @levity/api",
    "dev:api": "npm run dev -w @levity/api",
    "migration:generate": "npm run migration:generate -w @levity/api",
    "migration:run": "npm run migration:run -w @levity/api",
    "migration:revert": "npm run migration:revert -w @levity/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.5",
    "eslint": "^9.39.1",
    "globals": "^15.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
